# Copia este archivo a .env.local.
# URL de InventoryOS y una clave API de la empresa (Configuración › Claves API) con permisos
# catalog:read e inventory:read. La clave solo se usa en el servidor de la tienda; nunca llega al navegador.
INVENTORYOS_API_URL=http://localhost:3100
INVENTORYOS_API_KEY=ios_<clave>

# Nombre visible de la tienda y número de WhatsApp que recibe los pedidos (con indicativo, solo dígitos).
STORE_NAME=Mi tienda
STORE_WHATSAPP=573001234567

# Cada cuántos segundos se vuelve a leer el catálogo de InventoryOS (predeterminado: 60).
# CATALOG_REVALIDATE_SECONDS=60
