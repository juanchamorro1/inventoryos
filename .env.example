# Copia este archivo a .env.local y reemplaza los valores <...>.
# Con `npm run db:local:init`, .env.local se genera automáticamente con contraseñas aleatorias.

# Superusuario: solo para `npm run db:setup` (crear roles y bases). No lo uses en la aplicación.
DATABASE_ADMIN_URL=postgres://inventoryos_admin:<password>@127.0.0.1:5433/postgres
# Dueño del esquema: solo para migraciones.
DATABASE_OWNER_URL=postgres://inventoryos_owner:<password>@127.0.0.1:5433/inventoryos
# Rol de la aplicación (sujeto a Row-Level Security).
DATABASE_URL=postgres://inventoryos_app:<password>@127.0.0.1:5433/inventoryos
# Base de pruebas: las pruebas de integración la vacían y la recrean en cada ejecución.
TEST_DATABASE_OWNER_URL=postgres://inventoryos_owner:<password>@127.0.0.1:5433/inventoryos_test
TEST_DATABASE_URL=postgres://inventoryos_app:<password>@127.0.0.1:5433/inventoryos_test

APP_URL=http://localhost:3100

# Fotos: database (predeterminado, PostgreSQL) | s3 (compatible con S3; ver README › Variables de entorno).
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=<bucket>
# S3_ACCESS_KEY_ID=<clave>
# S3_SECRET_ACCESS_KEY=<secreto>

# TRM: datos-gov-co-trm (predeterminado) | none. Token opcional de Socrata y secreto del cron (mín. 16 caracteres).
# EXCHANGE_RATE_PROVIDER=datos-gov-co-trm
# EXCHANGE_RATE_APP_TOKEN=<token>
# CRON_SECRET=<secreto-largo-aleatorio>

# Correos de recuperación: disabled (predeterminado) | log (solo desarrollo: el enlace sale en la consola).
# MAIL_DRIVER=log

# Solo para Docker Compose:
# POSTGRES_ADMIN_PASSWORD=<password>
